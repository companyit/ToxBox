{
  "name": "toxbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-release.mjs",
    "preview": "vite preview --outDir dist",
    "build-only": "node scripts/build-release.mjs",
    "type-check": "vue-tsc --build && vue-tsc --noEmit -p tsconfig.tests.json",
    "build:csr": "vite build --outDir dist-csr",
    "test": "node scripts/e2e-run.mjs chromium",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:ssg": "vitest run --project ssg",
    "test:watch": "vitest --project unit --project components",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:legacy": "node --test tests/textStatistics.test.ts tests/jsonFormatter.test.ts tests/urlEncoder.test.ts tests/textStatisticsInteraction.test.mjs tests/jsonFormatterInteraction.test.mjs tests/urlEncoderInteraction.test.mjs tests/routingSeo.test.ts tests/ssg.test.mjs",
    "test:vitest": "vitest run --project unit --project components",
    "test:e2e": "node scripts/e2e-run.mjs chromium firefox webkit",
    "test:ci:e2e": "node scripts/e2e-run.mjs --prepared",
    "build:release": "node scripts/build-release.mjs",
    "build:preview": "run-p type-check \"build:preview-only {@}\" --",
    "build:preview-only": "node scripts/ssg.mjs",
    "preview:local": "vite preview --outDir dist-ssg"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
