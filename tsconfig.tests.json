{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "tests/unit/**/*.ts",
    "tests/components/**/*.ts",
    "tests/ssg/**/*.ts",
    "tests/helpers/**/*.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  }
}
